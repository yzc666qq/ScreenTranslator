<Window x:Class="ScreenTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Translator"
        Width="640"
        Height="760"
        MinWidth="560"
        MinHeight="620"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="#FFD8DBE6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Opacity="0.35" ShadowDepth="5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="20,8,12,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="译" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="Screen Translator" />
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="框选 · OCR · 实时模型翻译" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="MinimizeButton_Click"
                        Content="—"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="最小化" />
                <Button Grid.Column="2"
                        Click="CloseButton_Click"
                        Content="×"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="关闭" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,8,24,24">
                    <Border Padding="14,12" Background="#14FFFFFF" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot"
                                     Width="9"
                                     Height="9"
                                     Margin="0,4,11,0"
                                     VerticalAlignment="Top"
                                     Fill="#FF58D68D" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="StatusText"
                                           Foreground="White"
                                           Text="请选择需要翻译的屏幕区域" />
                                <TextBlock x:Name="StatusDetailText"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="密钥不会保存到项目文件" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,20,0,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF9FA6BA"
                               Text="捕获与显示" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="屏幕区域" />
                            <Button x:Name="SelectRegionButton"
                                    Height="38"
                                    Click="SelectRegionButton_Click"
                                    Background="#20FFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    Foreground="White"
                                    Content="框选区域" />
                            <TextBlock x:Name="RegionText"
                                       Margin="0,5,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="尚未选择" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="显示模式" />
                            <ComboBox x:Name="ModeComboBox"
                                      Height="38"
                                      SelectionChanged="ModeComboBox_SelectionChanged"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="覆盖所选区域" />
                                <ComboBoxItem Content="独立侧边面板" />
                            </ComboBox>
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="侧边面板可移动、缩放和锁定" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="目标语言（源语言自动检测）" />
                            <ComboBox x:Name="TargetLanguageComboBox"
                                      Height="36"
                                      IsEditable="True"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="日本語" Tag="ja" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="刷新间隔" />
                            <ComboBox x:Name="IntervalComboBox" Height="36" SelectedIndex="1">
                                <ComboBoxItem Content="0.7 秒" Tag="700" />
                                <ComboBoxItem Content="1.0 秒" Tag="1000" />
                                <ComboBoxItem Content="1.5 秒" Tag="1500" />
                                <ComboBoxItem Content="2.5 秒" Tag="2500" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="译文字体" />
                            <ComboBox x:Name="TranslationFontFamilyComboBox"
                                      Height="36"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      LostKeyboardFocus="TranslationFontFamilyComboBox_LostKeyboardFocus"
                                      SelectionChanged="TranslationFontFamilyComboBox_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="译文字号" />
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="TranslationFontSizeSlider"
                                        Minimum="10"
                                        Maximum="48"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="18"
                                        ValueChanged="TranslationFontSizeSlider_ValueChanged" />
                                <TextBlock x:Name="TranslationFontSizeText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="覆盖层透明度" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OverlayOpacitySlider"
                                    Minimum="0.35"
                                    Maximum="1"
                                    Value="0.88"
                                    ValueChanged="OverlayOpacitySlider_ValueChanged" />
                            <TextBlock x:Name="OverlayOpacityText"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Margin="0,22,0,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF9FA6BA"
                               Text="模型服务（OpenAI 兼容）" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="接口地址" />
                    <TextBox x:Name="EndpointTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="https://api.deepseek.com/chat/completions" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="模型" />
                            <TextBox x:Name="ModelTextBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="deepseek-v4-flash" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="API 密钥" />
                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Height="36"
                                         Padding="10,7"
                                         Background="#18FFFFFF"
                                         BorderBrush="#35FFFFFF"
                                         Foreground="White" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,7,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="也可设置 DEEPSEEK_API_KEY；只在识别文本发生变化时请求模型。" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Height="42"
                                Click="SelectRegionButton_Click"
                                Background="#20FFFFFF"
                                BorderBrush="#35FFFFFF"
                                Foreground="White"
                                Content="重新框选" />
                        <Button x:Name="StartStopButton"
                                Grid.Column="2"
                                Click="StartStopButton_Click"
                                Content="开始实时翻译"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
