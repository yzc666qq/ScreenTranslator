<Window x:Class="ScreenTranslator.App.Windows.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="#55000000"
        Cursor="Cross"
        PreviewKeyDown="Window_PreviewKeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Canvas x:Name="RootCanvas"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp"
            MouseMove="RootCanvas_MouseMove"
            MouseRightButtonUp="RootCanvas_MouseRightButtonUp">
        <Border Canvas.Left="24"
                Canvas.Top="24"
                Padding="12,8"
                Background="#E61A1D2A"
                CornerRadius="8"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       FontSize="14"
                       Text="拖动鼠标框选翻译区域 · Esc 或右键取消" />
        </Border>

        <Border x:Name="SelectionBorder"
                Background="#227C5CFC"
                BorderBrush="#FF8D75FF"
                BorderThickness="2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="SelectionSizeText"
                       Margin="8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Foreground="White"
                       FontWeight="SemiBold" />
        </Border>
    </Canvas>
</Window>
