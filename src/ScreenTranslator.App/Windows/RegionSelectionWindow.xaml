<Window x:Class="ScreenTranslator.App.Windows.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="#66050A0E"
        Cursor="Cross"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Canvas x:Name="RootCanvas"
            Background="Transparent"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp"
            MouseMove="RootCanvas_MouseMove">
        <Border Canvas.Left="24"
                Canvas.Top="24"
                Padding="12,8"
                Background="#F211171E"
                BorderBrush="#6632414D"
                BorderThickness="1"
                CornerRadius="10"
                IsHitTestVisible="False">
            <TextBlock Foreground="#FFF3F7FA"
                       FontSize="14"
                       Text="拖动鼠标框选翻译区域 · Esc 或右键取消" />
        </Border>

        <Border x:Name="SelectionBorder"
                Background="#1827D3BE"
                BorderBrush="#FF27D3BE"
                BorderThickness="2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="SelectionSizeText"
                       Margin="8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Foreground="#FFF3F7FA"
                       FontWeight="SemiBold" />
        </Border>
    </Canvas>
</Window>
