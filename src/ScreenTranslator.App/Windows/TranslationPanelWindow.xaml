<Window x:Class="ScreenTranslator.App.Windows.TranslationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="实时翻译"
        Icon="../Assets/app-icon.ico"
        Width="440"
        Height="360"
        MinWidth="280"
        MinHeight="180"
        Background="#FF0D1218"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="ClearType"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#2427D3BE" />
            <Setter Property="BorderBrush" Value="#3827D3BE" />
            <Setter Property="Foreground" Value="#FFF3F7FA" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="CompactToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="#2427D3BE" />
            <Setter Property="BorderBrush" Value="#3827D3BE" />
            <Setter Property="Foreground" Value="#FFF3F7FA" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border x:Name="PanelSurface"
            Background="#FF0D1218"
            BorderBrush="#4D32414D"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <ScrollViewer x:Name="TranslationScrollViewer"
                          Margin="12"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          VerticalScrollBarVisibility="Hidden">
                <TextBlock x:Name="TranslationText"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                           FontSize="17"
                           Foreground="#FFF3F7FA"
                           LineHeight="25"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <Border x:Name="ControlDock"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Padding="3"
                    Background="#E611171E"
                    BorderBrush="#4D32414D"
                    BorderThickness="1"
                    CornerRadius="8"
                    MouseEnter="ControlDock_MouseEnter"
                    MouseLeave="ControlDock_MouseLeave"
                    Opacity="0.18">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28"
                            Height="26"
                            Margin="2,0"
                            Background="#2427D3BE"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown"
                            ToolTip="拖动翻译框">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFF3F7FA"
                                   Text="⋮⋮" />
                    </Border>
                    <ToggleButton x:Name="LockToggle"
                                  MinWidth="42"
                                  Checked="LockToggle_Changed"
                                  Content="锁定"
                                  Style="{StaticResource CompactToggleStyle}"
                                  ToolTip="锁定位置和大小"
                                  Unchecked="LockToggle_Changed" />
                    <ToggleButton x:Name="OpacityToggle"
                                  Width="28"
                                  Content="◐"
                                  Style="{StaticResource CompactToggleStyle}"
                                  ToolTip="调整透明度" />
                    <Button Click="HideButton_Click"
                            Content="×"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="隐藏翻译框" />
                </StackPanel>
            </Border>

            <Popup x:Name="OpacityPopup"
                   AllowsTransparency="True"
                   Closed="OpacityPopup_Closed"
                   IsOpen="{Binding IsChecked, ElementName=OpacityToggle, Mode=TwoWay}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=OpacityToggle}"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <Border Width="190"
                        Margin="0,5,0,0"
                        Padding="12,9"
                        Background="#F211171E"
                        BorderBrush="#6632414D"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider"
                                Margin="0,0,8,0"
                                Minimum="0.35"
                                Maximum="1"
                                Value="1"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock x:Name="OpacityText"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#FF8996A5" />
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
