<Window x:Class="ScreenTranslator.App.Windows.TranslationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时翻译"
        Width="440"
        Height="360"
        MinWidth="280"
        MinHeight="180"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="CompactToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Margin="4"
            Background="#F21A1D2A"
            BorderBrush="#447C5CFC"
            BorderThickness="1"
            CornerRadius="9">
        <Grid>
            <ScrollViewer Margin="12"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TranslationText"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                           FontSize="17"
                           Foreground="White"
                           LineHeight="25"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <Border x:Name="ControlDock"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Padding="3"
                    Background="#D911141E"
                    BorderBrush="#447C5CFC"
                    BorderThickness="1"
                    CornerRadius="6"
                    MouseEnter="ControlDock_MouseEnter"
                    MouseLeave="ControlDock_MouseLeave"
                    Opacity="0.18">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28"
                            Height="26"
                            Margin="2,0"
                            Background="#28FFFFFF"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown"
                            ToolTip="拖动翻译框">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   Text="⋮⋮" />
                    </Border>
                    <ToggleButton x:Name="LockToggle"
                                  MinWidth="42"
                                  Checked="LockToggle_Changed"
                                  Content="锁定"
                                  Style="{StaticResource CompactToggleStyle}"
                                  ToolTip="锁定位置和大小"
                                  Unchecked="LockToggle_Changed" />
                    <ToggleButton x:Name="OpacityToggle"
                                  Width="28"
                                  Content="◐"
                                  Style="{StaticResource CompactToggleStyle}"
                                  ToolTip="调整透明度" />
                    <Button Click="HideButton_Click"
                            Content="×"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="隐藏翻译框" />
                </StackPanel>
            </Border>

            <Popup x:Name="OpacityPopup"
                   AllowsTransparency="True"
                   Closed="OpacityPopup_Closed"
                   IsOpen="{Binding IsChecked, ElementName=OpacityToggle, Mode=TwoWay}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=OpacityToggle}"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <Border Width="190"
                        Margin="0,5,0,0"
                        Padding="12,9"
                        Background="#F211141E"
                        BorderBrush="#667C5CFC"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider"
                                Margin="0,0,8,0"
                                Minimum="0.35"
                                Maximum="1"
                                Value="0.9"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock x:Name="OpacityText"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#FFB7BDCC" />
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
