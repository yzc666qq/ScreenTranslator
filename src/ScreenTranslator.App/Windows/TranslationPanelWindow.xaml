<Window x:Class="ScreenTranslator.App.Windows.TranslationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时翻译"
        Width="440"
        Height="360"
        MinWidth="280"
        MinHeight="180"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Border Margin="8"
            Background="#F21A1D2A"
            BorderBrush="#447C5CFC"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="12,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="实时译文" />
                <ToggleButton x:Name="LockToggle"
                              Grid.Column="1"
                              Width="58"
                              Height="28"
                              Margin="0,0,6,0"
                              Checked="LockToggle_Changed"
                              Content="锁定"
                              Foreground="White"
                              Unchecked="LockToggle_Changed" />
                <Button Grid.Column="2"
                        Width="28"
                        Height="28"
                        Click="HideButton_Click"
                        Content="×" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="12,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TranslationText"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                           FontSize="17"
                           Foreground="White"
                           LineHeight="25"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="12,2,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#FF9FA6BA"
                           Text="透明度" />
                <Slider x:Name="OpacitySlider"
                        Grid.Column="1"
                        Margin="10,0"
                        Minimum="0.35"
                        Maximum="1"
                        Value="0.9"
                        ValueChanged="OpacitySlider_ValueChanged" />
                <TextBlock x:Name="OpacityText"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#FF9FA6BA" />
            </Grid>
        </Grid>
    </Border>
</Window>
